ai-wardrobe.ru, www.ai-wardrobe.ru {
    encode gzip

    @api path /api/*
    handle @api {
        reverse_proxy server:4000
    }

    @uploads path /uploads/*
    handle @uploads {
        reverse_proxy server:4000
    }

    @ws path /ws/*
    handle @ws {
        reverse_proxy server:4000
    }

    handle {
        reverse_proxy client:3000
    }
}
