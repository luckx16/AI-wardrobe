{
  "name": "code",
  "version": "1.0.0",
  "description": "",
  "main": "./src/app.js",
  "scripts": {
    "start": "node --env-file .env ./src/app.js",
    "dev": "node --watch --env-file .env ./src/app.js",
    "start:prod": "cross-env NODE_ENV=production node --env-file .env ./src/app.js",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "db:unseed": "sequelize db:seed:undo:all",
    "db:reset": "sequelize db:drop && sequelize db:create && sequelize db:migrate && sequelize db:seed:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@langchain/classic": "^1.0.27",
    "@langchain/openai": "^1.4.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gigachat": "^0.0.18",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "ws": "^8.20.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
